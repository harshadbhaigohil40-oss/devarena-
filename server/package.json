{
  "name": "devarena-server",
  "version": "1.0.0",
  "description": "DEVARENA Backend API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seeds/index.js",
    "generate:frontend": "node scripts/generateChallenges.js --tree frontend --batch 25",
    "generate:backend": "node scripts/generateChallenges.js --tree backend --batch 25",
    "generate:algorithms": "node scripts/generateChallenges.js --tree algorithms --batch 25",
    "generate:systemdesign": "node scripts/generateChallenges.js --tree systemdesign --batch 25",
    "generate:all": "node scripts/generateChallenges.js --tree frontend --batch 25 && node scripts/generateChallenges.js --tree backend --batch 25 && node scripts/generateChallenges.js --tree algorithms --batch 25 && node scripts/generateChallenges.js --tree systemdesign --batch 25",
    "import:challenges": "node scripts/importChallenges.js --all"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
