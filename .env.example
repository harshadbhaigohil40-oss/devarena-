# MongoDB
MONGODB_URI=mongodb://localhost:27017/devarena

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Gemini AI (for AI Advisor & challenge generation)
# You can use a single key (GEMINI_API_KEY) or a comma-separated list of keys for automatic fallback (GEMINI_API_KEYS)
GEMINI_API_KEYS=your-first-gemini-key,your-second-gemini-key
GEMINI_API_KEY=your-gemini-api-key

# Client URL (for CORS and email links, comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Google OAuth (Backend verification & Frontend provider)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP settings (for email verification & password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
