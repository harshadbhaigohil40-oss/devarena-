# Client Environment Variables

# Base URL of the backend API (optional: defaults to http://localhost:5000 in dev or production URL)
# VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (Frontend provider)
# Required for Google Sign-In button to load properly
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
